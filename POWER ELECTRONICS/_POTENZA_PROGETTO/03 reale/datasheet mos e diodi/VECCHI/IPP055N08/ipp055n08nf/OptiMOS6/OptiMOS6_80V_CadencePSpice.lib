Cthb  Tb      0               7.316m
Rthb  Tb      Tj              {Rtb}
Rth1  Tj      t1              {1.18m+limit(Zthtype,0,1)*433.98u}
Rth2  t1      t2              {12.95m+limit(Zthtype,0,1)*4.79m}
Rth3  t2      t3              {28.55m+limit(Zthtype,0,1)*6.62m}
Rth4  t3      t4              {63.55m+limit(Zthtype,0,1)*29.97m}
Rth5  t4      Tcase           {171.2m+limit(Zthtype,0,1)*80.75m}
Cth1  Tj      0               387.87u
Cth2  t1      0               880.15u
Cth3  t2      0               3.62m
Cth4  t3      0               4.74m
Cth5  t4      0               139.48m
Cth6  Tcase   0               190m

.ENDS

